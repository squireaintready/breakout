# URL of the deployed Breakout web app (its /api/state endpoint is polled).
BREAKOUT_API_URL=https://your-app.vercel.app
# Shared secret — must match BREAKOUT_PASSWORD set on the web deployment.
BREAKOUT_PASSWORD=
# Accounts (datasets) to watch, comma-separated. Each entry is `id` or
# `id:Label`; the label is shown in Telegram alerts. Omit for a single default
# account. Example: main:100k,second:25k A
BREAKOUT_ACCOUNTS=main:100k,second:25k A,third:25k B,fourth:25k C,fifth:25k D
# Telegram bot credentials for delivering alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
